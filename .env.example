# Server
PORT=4000
# Allowed browser origins for CORS + Socket.IO (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Client (Vite; must be set at build time)
# Leave unset in development — the client defaults to same-origin.
# In production set to your deployed server URL, e.g. https://realtimecanvas-server.onrender.com
# VITE_SERVER_URL=
